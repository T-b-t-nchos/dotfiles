#!/bin/bash

export PATH="$PATH:/opt/nvim-linux-x86_64/bin"
export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:$HOME/.bin/sshhub"

eval "$(oh-my-posh init bash --config ~/.config/ohmyposh/theme/Aquaposh.omp.json)"

# Custom commands
alias mkcd() {
    mkdir -p "$1"
    cd "$1"
}

alias gitinit() {
    git init
    git commit --allow-empty -m "Initial commit"
}

alias cd() { z $* }
alias cdd() { builtin cd "$@" }
